    "--warning-soft":   "rgba(245, 166, 35, 0.12)",
    "--warning-line":   "rgba(245, 166, 35, 0.2)",
    "--warning-glow":   "rgba(245, 166, 35, 0.06)",
    "--danger-soft":    "rgba(224, 72, 64, 0.12)",
