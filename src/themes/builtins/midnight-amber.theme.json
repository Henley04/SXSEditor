    "--ink-soft":            "rgba(90, 80, 62, 0.3)",

    "--border-subtle":  "#1e1914",
    "--border-default": "#2e261e",
    "--border-strong":  "#3e352a",
    "--border-accent":  "#f5a623",

    "--success": "#40d070",
    "--warning": "#f5a623",
    "--danger":  "#f07068",
    "--info":    "#f5a623",

    "--scrollbar-thumb":       "rgba(62, 53, 42, 0.6)",
    "--scrollbar-thumb-hover": "rgba(80, 70, 55, 0.8)",
    "--scrollbar-track":       "transparent",

    "--selection-bg": "rgba(245, 166, 35, 0.4)",
    "--focus-ring":   "0 0 0 2px rgba(245, 166, 35, 0.3)",

    "--button-primary-bg":      "var(--bg-button-primary)",
    "--button-primary-fg":      "var(--fg-on-accent)",
    "--button-primary-hover":   "var(--bg-button-primary-hover)",
    "--button-secondary-bg":    "var(--bg-button)",
    "--button-secondary-fg":    "var(--fg-muted)",
    "--button-secondary-border":"#4a4035",
    "--button-disabled-bg":     "var(--color-ink-300)",
    "--button-danger-bg":       "var(--bg-button-danger)",

    "--input-bg":          "var(--bg-input)",
    "--input-border":      "var(--border-strong)",
    "--input-fg":          "var(--fg-primary)",
    "--input-focus-ring":  "var(--focus-ring)",
    "--input-placeholder": "var(--fg-disabled)",

    "--panel-bg":     "var(--bg-panel)",
    "--panel-border": "var(--border-default)",
    "--panel-fg":     "var(--fg-muted)",

    "--tooltip-bg": "var(--color-ink-300)",
    "--tooltip-fg": "var(--fg-primary)",

    "--selection-bg-token": "var(--selection-bg)",
    "--selection-fg":       "var(--fg-primary)",

    "--clip-button":    "none",
    "--clip-panel":     "none",
    "--clip-badge":     "none",
    "--deco-accent-bar":     "0",
    "--deco-stripe":         "none",
    "--toolbar-accent-line": "0"
