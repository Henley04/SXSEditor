    "--color-blue-500": "#d98a1a",
    "--color-blue-600": "#b87012",
    "--color-blue-700": "#8f560c",
    "--color-blue-800": "#5e3a08",
    "--color-blue-900": "#3d2604",

    "--accent":         "#f5a623",
    "--accent-hover":   "#fbc04d",
    "--accent-pressed": "#d98a1a",
    "--accent-soft":    "rgba(245, 166, 35, 0.15)",
    "--accent-softer":  "rgba(245, 166, 35, 0.06)",
    "--accent-glow":    "rgba(245, 166, 35, 0.25)",
