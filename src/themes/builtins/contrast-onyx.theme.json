{
  "id": "contrast-onyx",
  "name": "Onyx 高对比",
  "version": "1.0.0",
  "author": "SXSEditor",
  "isDark": true,
  "description": "高对比度无障碍主题，符合 WCAG AA",
  "tags": ["builtin", "dark", "accessibility", "high-contrast"],
  "tokens": {
    "--color-blue-50":  "#ffffff",
    "--color-blue-100": "#e0eaff",
    "--color-blue-200": "#b3c8ff",
    "--color-blue-300": "#80a0ff",
    "--color-blue-400": "#4d7bff",
    "--color-blue-500": "#1a4dff",
    "--color-blue-600": "#0033cc",
    "--color-blue-700": "#002699",
    "--color-blue-800": "#001966",
    "--color-blue-900": "#000d33",

    "--color-gray-50":  "#ffffff",
    "--color-gray-100": "#f0f0f5",
    "--color-gray-200": "#e0e0e8",
    "--color-gray-300": "#c8c8d0",
    "--color-gray-400": "#a0a0b0",
    "--color-gray-500": "#7a7a8c",
    "--color-gray-600": "#5a5a6c",
    "--color-gray-700": "#3a3a4a",
    "--color-gray-800": "#1a1a28",
    "--color-gray-900": "#0a0a14",

    "--color-ink-50":  "#1a1a28",
    "--color-ink-100": "#0a0a14",
    "--color-ink-200": "#000000",
    "--color-ink-300": "#000000",
    "--color-ink-400": "#000000",
    "--color-ink-500": "#000000",
    "--color-ink-600": "#000000",
    "--color-ink-700": "#000000",
    "--color-ink-800": "#000000",
    "--color-ink-900": "#000000",

    "--color-red-300":  "#ff9999",
    "--color-red-400":  "#ff5252",
    "--color-red-500":  "#ff0000",
    "--color-red-600":  "#cc0000",

    "--color-green-300": "#99ff99",
    "--color-green-400": "#00ff66",
    "--color-green-500": "#00cc52",
    "--color-green-600": "#009940",

    "--color-amber-300": "#ffd966",
    "--color-amber-400": "#ffbf00",
    "--color-amber-500": "#ff9900",

    "--color-white": "#ffffff",
    "--color-black": "#000000",

    "--bg-app":     "#000000",
    "--bg-panel":   "#0a0a14",
    "--bg-elevated":"#1a1a28",
    "--bg-input":   "#000000",
    "--bg-overlay": "rgba(0, 0, 0, 0.85)",
    "--bg-toolbar-start": "#1a1a28",
    "--bg-toolbar-end":   "#0a0a14",
    "--bg-header-start":  "#1a1a28",
    "--bg-header-end":    "#0a0a14",
    "--bg-button":   "#1a1a28",
    "--bg-button-hover": "#3a3a52",
    "--bg-button-active": "#000000",
    "--bg-button-primary":      "#1a4dff",
    "--bg-button-primary-hover":"#4d7bff",
    "--bg-button-success":      "#00ff66",
    "--bg-button-success-hover":"#99ff99",
    "--bg-button-danger":       "#ff0000",
    "--bg-button-danger-hover": "#ff5252",

    "--fg-primary":   "#ffffff",
    "--fg-secondary": "#f0f0f5",
    "--fg-muted":     "#e0e0e8",
    "--fg-disabled":  "#7a7a8c",
    "--fg-on-accent": "#ffffff",
    "--fg-on-success":"#000000",
    "--fg-on-warning":"#000000",

    "--accent":         "#4d7bff",
    "--accent-hover":   "#80a0ff",
    "--accent-pressed": "#1a4dff",
    "--accent-soft":    "rgba(77, 123, 255, 0.2)",
    "--accent-softer":  "rgba(77, 123, 255, 0.1)",
    "--accent-glow":    "rgba(77, 123, 255, 0.4)",
    "--accent-glow-strong": "rgba(77, 123, 255, 0.6)",
    "--accent-line":    "rgba(77, 123, 255, 0.35)",
    "--accent-line-strong": "rgba(77, 123, 255, 0.5)",
    "--accent-fg":      "#80a0ff",

    "--success-soft":   "rgba(0, 255, 102, 0.2)",
    "--success-glow":   "rgba(0, 255, 102, 0.4)",
    "--warning-soft":   "rgba(255, 191, 0, 0.2)",
    "--warning-line":   "rgba(255, 191, 0, 0.4)",
    "--warning-glow":   "rgba(255, 191, 0, 0.1)",
    "--danger-soft":    "rgba(255, 0, 0, 0.2)",
    "--danger-glow":    "rgba(255, 0, 0, 0.4)",
    "--purple-soft":    "rgba(168, 85, 247, 0.2)",

    "--shadow-color":        "rgba(255, 255, 255, 0.2)",
    "--shadow-color-mid":    "rgba(255, 255, 255, 0.3)",
    "--shadow-color-strong": "rgba(255, 255, 255, 0.5)",
    "--overlay-scrim":       "rgba(0, 0, 0, 0.85)",
    "--panel-line":          "rgba(255, 255, 255, 0.5)",
    "--ink-soft":            "rgba(255, 255, 255, 0.3)",

    "--border-subtle":  "#1a1a28",
    "--border-default": "#3a3a4a",
    "--border-strong":  "#7a7a8c",
    "--border-accent":  "#4d7bff",

    "--success": "#00ff66",
    "--warning": "#ffbf00",
    "--danger":  "#ff0000",
    "--info":    "#4d7bff",

    "--scrollbar-thumb":       "#7a7a8c",
    "--scrollbar-thumb-hover": "#ffffff",
    "--scrollbar-track":       "#000000",

    "--selection-bg": "rgba(77, 123, 255, 0.5)",
    "--focus-ring":   "0 0 0 3px rgba(77, 123, 255, 0.6)",

    "--shadow-sm": "0 0 0 1px #1a1a28",
    "--shadow-md": "0 0 0 1px #3a3a4a",
    "--shadow-lg": "0 0 0 2px #3a3a4a",
    "--shadow-xl": "0 0 0 2px #7a7a8c",

    "--button-primary-bg":      "var(--bg-button-primary)",
    "--button-primary-fg":      "var(--fg-on-accent)",
    "--button-primary-hover":   "var(--bg-button-primary-hover)",
    "--button-secondary-bg":    "var(--bg-button)",
    "--button-secondary-fg":    "var(--fg-primary)",
    "--button-secondary-border":"var(--border-strong)",
    "--button-disabled-bg":     "#0a0a14",
    "--button-danger-bg":       "var(--bg-button-danger)",

    "--input-bg":          "var(--bg-input)",
    "--input-border":      "var(--border-strong)",
    "--input-fg":          "var(--fg-primary)",
    "--input-focus-ring":  "var(--focus-ring)",
    "--input-placeholder": "#7a7a8c",

    "--panel-bg":     "var(--bg-panel)",
    "--panel-border": "var(--border-strong)",
    "--panel-fg":     "var(--fg-primary)",

    "--tooltip-bg": "#ffffff",
    "--tooltip-fg": "#000000",

    "--selection-bg-token": "var(--selection-bg)",
    "--selection-fg":       "var(--fg-primary)"
  }
}
