# Generated at package time by scripts/generate-build-info.js (also run by the
# prestart / prepackage hooks). It only mirrors package.json, so keeping it in
# git lets it drift from the real source of truth — the highest semver git tag.
src/build-info.json

# Splash bitmaps: generated by scripts/generate-splash-image.js at build time
# (prestart / prepackage). They carry the build timestamp and version, so they
# must be regenerated per build rather than committed (a committed copy would
# show a stale date). There is no splash HTML any more — the window uses
# BaseWindow + ImageView and reads these PNGs directly.
src/splash.png
src/splash@2x.png
src/splash@3x.png

