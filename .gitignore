# Logs
logs
*.log
*_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock
.DS_Store

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html) and node-gyp cache
build/

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Webpack
.webpack/

# Vite
.vite/

# Electron-Forge
out/

# ONNX models
*.onnx
*.onnx.data

# Quantized ONNX model directories
onnx_models/int8/
onnx_models/fp16/

# External speech datasets (only used for stats building, not runtime)
raw_data/
preprocessed_data/
lexicon/

# ExecuTorch models
*.pte
*.pte.data
executorch_models/

# SVC models
svc/

# Installer build output (iss files are tracked; *.exe/*.bin handle binaries)
*.exe
*.bin
*.zip

# Large binary data files
*.data

# Training data outputs (regenerated by scripts, exceed GitHub 100MB limit)
scripts/mel_proj_train_output/mlp_mel_data.npy
scripts/mel_proj_train_output/mlp_target_data.npy

# FP16 calibration data (regenerated by generate_fp16_calibration.py, large npz files)
calibrate/data/fp16_calib/*.npz

# FP16 precision comparison reports (regenerated by merge_comparison_results.py)
fp16_precision_comparison*.json
fp16_precision_comparison*.csv

# Preprocess model binaries (auto-downloaded, only README tracked)
onnx_models/preprocess/*.pt
onnx_models/preprocess/*.onnx
onnx_models/preprocess/*.onnx.data

# FP16 model directories (regenerated by conversion scripts, onnx files already gitignored)
onnx_models/fp16_backup/
onnx_models/fp16_w16a32/
onnx_models/fp16_true/

# TRT-RTX diagnostic reports (runtime artifacts, regenerated on each run)
onnx_models/diagnostics/

# PyTorch FP16 quantized model (1.3GB, exceeds GitHub 100MB limit, regenerated by quantize_pytorch_fp16_calib.py)
pretrained_models_fp16/*.pt

# Webpack dist output
dist/

# Native addon build
native/build/

# ExecuTorch source
executorch_c++/

# SoulX-Singer submodule (external dependency, no git URL available)
SoulX-Singer/

# SiFiGAN source repo (external dependency, cloned from github.com/chomeyama/SiFiGAN)
third_party/

# AtomCode local-scope configs (machine-specific)
.atomcode/local/

# Claude Code local settings
.claude/

# DuMate working files
.dumate/

# ONNX model backups (opset upgrade)
*.bak

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Web design draft templates (not part of shipped site)
draft/

# Local backup directory (manual backups before edits)
.backup/

# Exported audio files
*.wav

# TRT FP16 calibration data (large npz files, regenerated by scripts)
calibrate/data/trt_fp16/

# INT8 quantization output (large binary artifacts, regenerated)
int8_output/

# Evaluation datasets (large, not part of repo)
eval_data/

# Native ort-bridge prebuilt binaries (regenerated by node-gyp)
native/ort-bridge/bin/

# ONNX Runtime profiling output
onnxruntime_profile__*.json

# Temporary inspection scripts
_tmp_*.js

# WorkBuddy assistant workspace (local only)
.workbuddy/

# Local experiment artifacts (loudness / quantization A-B tests, W16A32 training)
/ab_*.csv
/ab_*.json
/vocoder_W16A32.pt
/w16a32_output/
/ui-design-preview.html

# Q-Drift throwaway inspection probes (topology / ext checks)
qdrift/eval/check_ext*.py
qdrift/eval/check_wav_energy.js
qdrift/eval/inspect_*.py
qdrift/eval/inspect_*.txt
qdrift/eval/make_probe.py
qdrift/eval/topo*.py
qdrift/eval/topo*_out.txt

# Temporary working directory
.tmp/

# FCPE integration patch (WIP, not committed)
fcpe_download_integration.patch

# UI preview server runtime log
preview-server.err


# Q-Drift: only the code, README and the calibration result are tracked.
# The condition tensors come from modelscope.cn/models/syxppp/Qdrift and the
# rest is derived (see qdrift/README.md for the reproduction steps).
qdrift/conds_long/
qdrift/conds_bin/
qdrift/conds_proj/
qdrift/eval/mel/
qdrift/eval/wav/
qdrift/diag/
qdrift/calib/qdrift_state.json
qdrift/calib_int8/qdrift_state.json
qdrift/calib_fp16_run.log
qdrift/calib_int8_run.log
qdrift/eval_fp16_run.log
_qdrift_pkg/

# ...but keep the calibration result despite the global *.bin rule above.
!qdrift/calib/qdrift_V.bin
!qdrift/calib/qdrift_c.bin
!qdrift/calib_int8/qdrift_V.bin
!qdrift/calib_int8/qdrift_c.bin
