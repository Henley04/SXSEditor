{
  "name": "sxseditor",
  "productName": "SXSEditor",
  "version": "1.0.0",
  "description": "SoulX Singer Editor - AI歌声合成工作台",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "prepackage": "node scripts/generate-build-info.js",
    "package": "cross-env NODE_ENV=production electron-forge package",
    "prepackage:lite": "node scripts/generate-build-info.js",
    "package:lite": "cross-env SKIP_ONNX_MODELS=1 NODE_ENV=production electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src test scripts *.config.js --ext .js",
    "test": "mocha --require ./test/setup.js \"test/**/*.test.js\" --timeout 30000 --reporter spec",
    "test:ci": "mocha --require ./test/setup.js \"test/**/*.test.js\" --ignore \"test/onnxModelLoading.test.js\" --timeout 30000 --reporter spec",
    "test:coverage": "nyc --reporter=text --reporter=html npm test",
    "test:watch": "mocha --require ./test/setup.js \"test/**/*.test.js\" --timeout 30000 --watch",
    "cli": "electron-forge start -- --cli",
    "cli:help": "electron-forge start -- --cli help"
  },
  "keywords": [
    "electron",
    "svs",
    "ai",
    "music",
    "singing"
  ],
  "author": {
    "name": "SXSEditor Dev",
    "email": "dev@sxseditor.local"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.4",
    "@vercel/webpack-asset-relocator-loader": "^1.10.0",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "electron": "^42.4.1",
    "electron-squirrel-startup": "^1.0.1",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "mocha": "^11.7.6",
    "node-loader": "^2.1.0",
    "nyc": "^18.0.0",
    "sinon": "^21.1.2",
    "style-loader": "^3.3.4",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "decibri": "^5.0.0",
    "onnxruntime-node": "^1.27.0",
    "onnxruntime-web": "^1.27.0",
    "pinyin-pro": "^3.28.1",
    "systeminformation": "^5.31.9"
  },
  "optionalDependencies": {
    "nan": "^2.27.0"
  },
  "overrides": {
    "segfault-handler": "npm:empty-npm-package@1.0.0"
  }
}
