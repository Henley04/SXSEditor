# Pin every install to the public npm registry.
#
# Why this file exists instead of a rewritten package-lock.json:
#   package-lock.json currently resolves 1294 of its 1295 `resolved` entries
#   from registry.npmmirror.com, and nothing in the repo pinned a registry, so
#   install provenance was implicitly delegated to a third-party mirror.
#   Regenerating the lockfile would be the thorough fix, but it rewrites ~1294
#   lines, needs network access, and risks silent `version`/`integrity` drift
#   (a changed integrity means a changed tarball, not just a changed host).
#   Pinning the registry here is the safe first step: `npm ci` still verifies
#   each existing entry against its recorded SHA-512 integrity, while any newly
#   added dependency is resolved from npmjs.
#   Phase 2 (do it deliberately, review host-only changes):
#     npm install --package-lock-only --registry=https://registry.npmjs.org
#     git diff -U0 package-lock.json | grep '^[-+]'   # only hosts may change
#
# Local override (e.g. maintainers in mainland China) without touching the repo:
#   npm config set registry https://registry.npmmirror.com --location=user
#   or: NPM_CONFIG_REGISTRY=... npm ci
registry=https://registry.npmjs.org/
always-auth=false
