{
  "apiVersion": 2,
  "id": "official-project-import",
  "name": "Official Project Import (VOCALOID / Synthesizer V)",
  "version": "1.2.0",
  "description": "官方插件：打开与保存 VOCALOID3/4 的 .vsqx、VOCALOID5/6 的 .vpr、Synthesizer V / SV2 的 .svp 工程（音符、歌词、音高曲线、速度、拍号、轨道与分片）。.vpr 的伴奏音频导入为伴奏轨，写回时连同音频字节与音频轨结构一并还原进 ZIP 容器；.vsqx/.svp 无内嵌音频容器，伴奏不会写回并会告警。写回外部格式为有损保存，插件会逐条告警并建议另存为宿主原生格式。格式结构参考 Apache-2.0 的开源实现 UtaFormatix，解析与编码代码为独立重写。",
  "author": "SXSEditor Official",
  "main": "main.js",
  "engines": {
    "app": ">=2.0.0"
  },
  "permissions": {
    "fs": [
      "userPicked:read",
      "userPicked:write"
    ],
    "project": [
      "read"
    ],
    "ui": [
      "statusBar"
    ]
  },
  "contributes": {
    "fileTypes": [
      {
        "ext": ".vsqx",
        "role": "both",
        "label": {
          "en": "VOCALOID3/4 Sequence (VSQX)",
          "zh-CN": "VOCALOID3/4 工程 (VSQX)"
        },
        "filters": [
          "VOCALOID VSQX"
        ]
      },
      {
        "ext": ".vpr",
        "role": "both",
        "label": {
          "en": "VOCALOID5/6 Project (VPR)",
          "zh-CN": "VOCALOID5/6 工程 (VPR)"
        },
        "filters": [
          "VOCALOID VPR"
        ]
      },
      {
        "ext": ".svp",
        "role": "both",
        "label": {
          "en": "Synthesizer V Project (SVP)",
          "zh-CN": "Synthesizer V 工程 (SVP)"
        },
        "filters": [
          "Synthesizer V SVP"
        ]
      }
    ],
    "statusBar": [
      {
        "id": "state",
        "text": {
          "en": "Import: ready",
          "zh-CN": "导入：就绪"
        },
        "tooltip": {
          "en": "VOCALOID / Synthesizer V project import",
          "zh-CN": "VOCALOID / Synthesizer V 工程导入"
        },
        "alignment": "right"
      }
    ]
  }
}
