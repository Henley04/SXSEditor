{
  "apiVersion": 2,
  "id": "example-models",
  "name": "Example: Model Call",
  "version": "1.0.0",
  "description": "模型调用面的最小示例：一个命令用 chat 任务问一句并把流式结果写进状态栏；另一个命令故意自建 HTTP，用来看运行时的出站封锁。复制这个目录改名即可开工。",
  "author": "SXSEditor Dev",
  "main": "main.js",
  "engines": {
    "app": ">=2.0.0"
  },
  "permissions": {
    "models": ["consume"],
    "ui": ["menu", "statusBar", "settings"]
  },
  "contributes": {
    "commands": [
      {
        "id": "ask",
        "title": {
          "en": "Ask the model",
          "zh-CN": "问一下模型"
        },
        "description": "用 chat 任务问一句，流式结果实时写进状态栏。端点由宿主按任务绑定选择，插件不指定。"
      },
      {
        "id": "probeNet",
        "title": {
          "en": "Try a direct HTTP call (blocked)",
          "zh-CN": "直接发 HTTP（会被拦）"
        },
        "description": "演示运行时的出站封锁：插件进程不允许自建网络连接，必须走 ctx.models.invoke。"
      }
    ],
    "menus": [
      {
        "path": "plugins/example",
        "command": "ask"
      }
    ],
    "statusBar": [
      {
        "id": "last",
        "text": {
          "en": "@modelIdle",
          "zh-CN": "@modelIdle"
        },
        "tooltip": {
          "en": "Result of the last model call",
          "zh-CN": "上一次模型调用的结果"
        },
        "alignment": "right"
      }
    ],
    "models": {
      "consumes": ["chat"],
      "preferred": [
        {
          "task": "chat",
          "provider": "openai",
          "note": "示例：中文对话更稳。只是设置页里的一颗 ★，不会替用户选中。"
        }
      ]
    },
    "settings": [
      {
        "id": "general",
        "title": {
          "en": "Question",
          "zh-CN": "提问内容"
        },
        "fields": [
          {
            "key": "prompt",
            "type": "string",
            "default": "用一句话介绍你自己",
            "label": {
              "en": "Prompt",
              "zh-CN": "提示词"
            },
            "description": {
              "en": "Sent to the endpoint bound to the chat task.",
              "zh-CN": "会发给绑定在 chat 任务上的端点。"
            }
          }
        ]
      }
    ],
    "i18n": {
      "en": {
        "modelIdle": "Model: idle",
        "modelWorking": "Model: thinking…",
        "modelNoEndpoint": "No endpoint bound to chat",
        "modelDenied": "Model access denied"
      },
      "zh-CN": {
        "modelIdle": "模型：空闲",
        "modelWorking": "模型：思考中…",
        "modelNoEndpoint": "chat 任务还没有绑定端点",
        "modelDenied": "模型调用被拒绝"
      }
    }
  }
}
