{
  "apiVersion": 2,
  "id": "example-consumer",
  "name": "Example: Service Consumer",
  "version": "1.0.0",
  "description": "服务消费方示例：声明依赖 example.clock 与插件级依赖 example-clock，通过 ctx.services 调用它，并演示用 ctx.plugins.resolveDependencies() 查询部署依赖；提供方可选缺失时插件显示为 degraded。",
  "author": "SXSEditor Dev",
  "main": "main.js",
  "engines": {
    "app": ">=2.0.0"
  },
  "permissions": {
    "services": [
      "consume"
    ],
    "ui": [
      "menu"
    ],
    "automation": [
      "expose"
    ],
    "plugins": [
      "inspect"
    ]
  },
  "dependencies": [
    {
      "id": "example-clock",
      "range": "^1.0.0",
      "optional": false
    }
  ],
  "contributes": {
    "services": {
      "consumes": [
        {
          "id": "example.clock",
          "range": "^1.0.0",
          "optional": false
        }
      ]
    },
    "commands": [
      {
        "id": "now",
        "title": {
          "en": "Read clock from another plugin",
          "zh-CN": "从另一个插件读时钟"
        },
        "description": "调用 example.clock 的 now()，返回提供方、版本与它自己的启动时长。"
      },
      {
        "id": "deps",
        "title": {
          "en": "Show declared plugin dependencies",
          "zh-CN": "查看声明的插件依赖"
        },
        "description": "列出 manifest.dependencies 的满足情况与已安装插件；只读，不触发安装。"
      }
    ],
    "menus": [
      {
        "path": "plugins/example",
        "command": "now"
      }
    ],
    "automation": {
      "methods": [
        "now"
      ]
    }
  }
}
