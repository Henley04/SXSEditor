{
  "apiVersion": 2,
  "id": "example-sv2",
  "name": "Example: SV2 Project",
  "version": "1.0.0",
  "description": "数据面示例：声明接管 .sv2 文件（read/write 双向转换），并提供一个 .pcm 导出器演示成品导出。",
  "author": "SXSEditor Dev",
  "main": "main.js",
  "engines": {
    "app": ">=2.0.0"
  },
  "permissions": {
    "fs": [
      "pluginData",
      "userPicked:read",
      "userPicked:write"
    ],
    "project": [
      "read"
    ],
    "ui": [
      "menu",
      "statusBar"
    ],
    "automation": [
      "expose"
    ]
  },
  "contributes": {
    "fileTypes": [
      {
        "ext": ".sv2",
        "role": "both",
        "label": {
          "en": "SV2 Project",
          "zh-CN": "SV2 工程"
        },
        "filters": [
          "SV2 Project"
        ]
      }
    ],
    "commands": [
      {
        "id": "about",
        "title": {
          "en": "About the SV2 example",
          "zh-CN": "关于 SV2 示例"
        },
        "description": "说明这个插件接管的文件格式，以及打开后内容是怎么进到编辑器里的。"
      },
      {
        "id": "stats",
        "title": {
          "en": "SV2 decoder statistics",
          "zh-CN": "SV2 解码统计"
        },
        "description": "返回本进程处理过的 SV2 文件数（示例：把命令暴露给自动化面）。"
      }
    ],
    "menus": [
      {
        "path": "plugins/example",
        "command": "about"
      }
    ],
    "statusBar": [
      {
        "id": "state",
        "text": {
          "en": "@sv2Idle",
          "zh-CN": "@sv2Idle"
        },
        "tooltip": {
          "en": "Last file decoded by this plugin",
          "zh-CN": "这个插件最近解码的文件"
        },
        "alignment": "right"
      }
    ],
    "i18n": {
      "en": {
        "sv2Idle": "SV2: idle",
        "sv2Opened": "SV2: {name}",
        "sv2About": "This plugin owns .sv2 files. Open one from File → Open Project: the dialog lists it, and its content is decoded here, then handed to the host as a normal project document."
      },
      "zh-CN": {
        "sv2Idle": "SV2：空闲",
        "sv2Opened": "SV2：{name}",
        "sv2About": "这个插件接管 .sv2 文件。从「文件 → 打开工程」选一个，对话框里会列出这个格式；内容在这里被解码，然后作为普通工程文档交给宿主。"
      }
    },
    "exporters": [
      {
        "id": "pcm16",
        "ext": ".pcm",
        "label": {
          "en": "PCM 16-bit (example)",
          "zh-CN": "PCM 16 位（示例）"
        },
        "mime": "audio/L16",
        "description": "演示导出器贡献点：把成品采样写成裸 PCM，宿主负责写盘。"
      }
    ],
    "automation": {
      "methods": [
        "stats"
      ]
    }
  }
}
