{
  "identifier": "default",
  "description": "Default capabilities for SXSEditor-Pad",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:scope-app-recursive",
    "fs:scope-download-recursive",
    "shell:default",
    "shell:allow-open",
    "process:default",
    "process:allow-exit"
  ]
}